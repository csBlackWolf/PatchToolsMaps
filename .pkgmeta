package-as: PatchToolsMaps
enable-nolib-creation: no
required-dependencies:
  - patchtools
ignore:
  - ALPHA-FRAME.md
  - INTEGRATION.md
  - GUIDE.md
  - AGENTS.md
  - .gitignore
  - .gitattributes
  - .pkgmeta
  - README.md
  - DEVELOPMENT.md
  - .github
  - tests
  - tools
  - RESEARCH.md
  - CATALOG-MANIFEST.json
  - CATALOG-MANIFEST-ERA.json

manual-changelog: CHANGELOG.md
