ignore:
  - GUIDE.md
  - AGENTS.md
  - .gitignore
  - .gitattributes
  - .pkgmeta
  - README.md
  - ALPHA-FRAME.md
  - INTEGRATION.md
  - DEVELOPMENT.md
  - .github
  - tests
  - tools
  - RESEARCH.md
  - CATALOG-MANIFEST.json
  - CATALOG-MANIFEST-ERA.json
  - CATALOG-MANIFEST-ERA-70576.json

  - CATALOG-MANIFEST-FOREVER-70790.json

  - CATALOG-MANIFEST-FOREVER-70862.json

  - CATALOG-MANIFEST-FOREVER-70888.json

  - CATALOG-MANIFEST-FOREVER-70938.json

manual-changelog: CHANGELOG.md
